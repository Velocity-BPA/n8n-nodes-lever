{
  "name": "n8n-nodes-lever",
  "version": "1.0.0",
  "description": "A comprehensive n8n community node for Lever ATS providing 11 resources and 60+ operations for recruiting automation, candidate management, and hiring workflows.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Velocity BPA",
    "email": "licensing@velobpa.com",
    "url": "https://velobpa.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Velocity-BPA/n8n-nodes-lever.git"
  },
  "homepage": "https://github.com/Velocity-BPA/n8n-nodes-lever#readme",
  "bugs": {
    "url": "https://github.com/Velocity-BPA/n8n-nodes-lever/issues"
  },
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "lever",
    "ats",
    "applicant-tracking-system",
    "recruiting",
    "hiring",
    "hr",
    "human-resources",
    "candidates",
    "interviews",
    "workflow-automation"
  ],
  "main": "dist/nodes/Lever/Lever.node.js",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/LeverApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Lever/Lever.node.js",
      "dist/nodes/Lever/LeverTrigger.node.js"
    ]
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.25",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "n8n-workflow": "1.57.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.2"
  },
  "peerDependencies": {
    "n8n-workflow": ">=1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}